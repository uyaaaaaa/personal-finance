#!/bin/sh
# GitHub の ruleset と重複するが、hook は push を待たずコミット時点で止められる。
set -eu

# 既定ブランチ名は origin/HEAD から導出し、ruleset の ~DEFAULT_BRANCH と判定基準を揃える。
protected=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
[ -n "$protected" ] || protected='main'
branch=$(git symbolic-ref --quiet --short HEAD || echo '')

if [ "$branch" = "$protected" ]; then
  echo "pre-commit: $protected への直接コミットは禁止されています。" >&2
  echo "  git switch -c <branch> でトピックブランチを作成してください。" >&2
  exit 1
fi

# public リポジトリのため、秘密情報は一度コミットすれば取り消せない。
# 検査対象は追加行のみとする。既存行は公開済みであり、ここで止めても手遅れである。
secret='gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|xox[baprs]-[A-Za-z0-9-]{10,}|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\.|-----BEGIN [A-Z ]*PRIVATE KEY-----'
found=0

git diff --cached --name-only --diff-filter=ACM | while IFS= read -r file; do
  [ -n "$file" ] || continue

  # 雛形は値を持たないため許可し、実体の環境変数ファイルのみを拒否する。
  case "$file" in
    *.example|*.sample|*.template) ;;
    .env|.env.*|*/.env|*/.env.*)
      echo "pre-commit: 環境変数ファイルはコミットできません: $file" >&2
      exit 1
      ;;
  esac

  if git diff --cached -U0 -- "$file" | grep '^+' | grep -v '^+++' | grep -Eq "$secret"; then
    echo "pre-commit: 秘密情報らしき文字列を検出しました: $file" >&2
    exit 1
  fi
done || found=1

[ "$found" -eq 0 ] || {
  echo "  値を環境変数に移すか、誤検出であれば git commit --no-verify で通してください。" >&2
  exit 1
}
